# Required
DISCORD_TOKEN=
# Guild the bot runs in (commands are registered here for instant availability)
GUILD_ID=
# Optional overrides (defaults shown)
VERIFIED_ROLE_ID=1174862374411456582
# Channel for deadline reminders / open+close announcements (defaults to the channel /classphoto open is run in)
ANNOUNCE_CHANNEL_ID=
# Role allowed to run admin subcommands (in addition to members with Manage Server)
ADMIN_ROLE_ID=
# Comma-separated server (world) list shown in the dropdown; max 25
SERVERS=Bera,Scania,Luna,Aurora,Elysium,Kronos,Hyperion,Solis,Reboot NA,Reboot EU,Other
# Where submissions are stored. On Railway, point this at a mounted volume (e.g. /data)
DATA_DIR=./data
MAX_PER_USER=3
